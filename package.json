{
  "name": "hpharness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/providers",
    "packages/extensions",
    "packages/harness"
  ],
  "scripts": {
    "build": "npm run build --workspace @hpharness/providers && npm run build --workspace @hpharness/extensions && npm run build --workspace @hpharness/harness",
    "test": "npm test --workspaces --if-present",
    "desktop": "cargo run -p hpharness-desktop",
    "start": "node packages/harness/dist/main.js"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
